# ================================================================ CAÍDOS e ROLAMENTO (todas as direções)
pal bruna
# caída: escudo tombado atrás do corpo, trança solta no chão
# rolamento: ponta da trança voando
pal ravi
# caído: capuz, cachecol e um disco que escapou da bolsa
# rolamento: capuz por cima
pal domador
# caído: capacete de osso com chifres, máscara, chicote enrolado no chão
# rolamento: capacete e chifres
pal domadora
# caída: coque, máscara, capa rasgada aberta no chão
# rolamento: pontas da capa
pal vesna
# caída: coroa de chifres, capa carmesim aberta sob o corpo
# rolamento: coroa e capa enrolada
