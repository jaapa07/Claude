# Animação e efeitos (passe de polimento). Tudo desenhado à mão, pixel a pixel.
# Prefixo dos quadros: an_ (nomes de quadro são globais entre os arquivos .pxl).

# ---------------------------------------------------------------- matriz de pontilhado 4x4 (16 níveis)
# Usada pela transição de mapa (fade em pontilhado) e pela desintegração dos inimigos:
# cada célula guarda o "momento" em que aquele pixel some/aparece.
palette an_bayer
  0 = #000000
  1 = #111111
  2 = #222222
  3 = #333333
  4 = #444444
  5 = #555555
  6 = #666666
  7 = #777777
  8 = #888888
  9 = #999999
  a = #aaaaaa
  b = #bbbbbb
  c = #cccccc
  d = #dddddd
  e = #eeeeee
  f = #ffffff
end
pal an_bayer

frame an_bayer
082a
c4e6
3b19
f7d5
end

palette an
  w = #ffffff
  l = #d6dcec
  m = #9aa4c0
  v = #9be8ff
  V = #3a8ac8
  c = #bfe9ff
  t = #d8c8a0
  T = #a89070
  g = #a8f070
  G = #4f9a3a
  d = #2f6a2c
  o = #e0a040
  y = #ffe680
  Y = #f0a838
  h = #fff4c0
  r = #ff5a48
  a = #b8f06088
  f = #f8ffb0
  P = #b48cff
  p = #e8d8ff
  D = #5a3a9a
  K = #1b1626
end
pal an

