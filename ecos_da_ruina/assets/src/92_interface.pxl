# Interface 2 — molduras, ícones de aviso e retratos de quem fala. Desenho autoral, pixel a pixel.
# Folhas: ui2_frames.png (molduras 9-slice 24x24, margem 8), ui2_sel.png (barra de seleção 12x12, margem 4),
#         ui2_icons.png (ícones de aviso 16x16), ui2_more.png (seta "continuar" 8x8), ui2_portraits.png (retratos 32x32).

# ---------------------------------------------------------------- MOLDURAS
# letras: K contorno, H ouro, O sombra do ouro, m bisel interno, l miolo, g/w/e pedra do canto
palette ui2
  K = #120e1c
  H = #e8b850
  O = #8a5a28
  m = #3a3050
  l = #1e182cf2
  g = #3aa8d8
  w = #9ae8ff
  e = #ffffff
end
# diálogo: prata azulada com pedra âmbar
palette ui2_dlg from ui2
  H = #a8b8d8
  O = #4a5a80
  m = #2c3458
  l = #141a30
  g = #e8a838
  w = #ffd870
end
# aviso: vermelho com pedra amarela
palette ui2_warn from ui2
  H = #e86a50
  O = #8a2a24
  m = #4a2028
  l = #26121af2
  g = #ffd040
  w = #fff0a0
end
# chefão: carmim escuro e ouro velho
palette ui2_boss from ui2
  K = #0a0408
  H = #c8a040
  O = #5a1820
  m = #3a1018
  l = #1a0a10f2
  g = #e83040
  w = #ff9090
end
# HUD: lilás discreto, pedra verde
palette ui2_hud from ui2
  H = #a89cc8
  O = #4a4068
  m = #2e2840
  l = #1a1626e6
  g = #7ad080
  w = #c8ffc8
end
# brilho de raridade: só o contorno, em branco (a cor vem do modulate)
palette ui2_glow from ui2
  K = #ffffff60
  H = #ffffff
  O = #d0d0d0
  m = #ffffff40
  l = #00000000
  g = #ffffff
  w = #ffffff
  e = #ffffff
end
# aba do nome no diálogo: ouro com miolo vinho
palette ui2_tab from ui2
  m = #4a2a40
  l = #2e1a2cf4
  g = #ffd870
  w = #fff6c8
end
pal ui2

frame ui2_panel mirror4
..KKKKKKKKKK
..KgKHHHHHHH
.KgwgKOOOOOO
KgwewgKKKKKK
.KgwgKmmmmmm
..KgKmllllll
KHOKmlllllll
KHOKmlllllll
KHOKmlllllll
KHOKmlllllll
KHOKmlllllll
KHOKmlllllll
end
sheet ui2_frames.png 24 24 7
ui2_panel
ui2_panel pal=ui2_dlg
ui2_panel pal=ui2_warn
ui2_panel pal=ui2_boss
ui2_panel pal=ui2_hud
ui2_panel pal=ui2_glow
ui2_panel pal=ui2_tab
end

# barra de seleção (9-slice 12x12, margem 4)
palette ui2s
  H = #e8dcff
  s = #b8a4ff90
  f = #6a58c060
end
pal ui2s
frame ui2_selbar mirror4
..HHHH
.Hssss
Hsffff
Hsffff
Hsffff
Hsffff
end
sheet ui2_sel.png 12 12 1
ui2_selbar
end

