# Minichefe e guardião da Fortaleza do Eclipse — desenho autoral pixel a pixel. Voltados para a direita.
# gemeo_ferro.png / gemeo_ferro_b.png (40x40, 9 colunas): os Gêmeos de Ferro (mesmo corpo; o segundo tem a paleta ferrugem-violeta).
# cavaleiro.png (64x64, 9 colunas): Cavaleiro Sem Rosto. windup = recolhe a lâmina para a estocada; attack = estocada; hurt = recuo.
# cavaleiro_posturas.png (64x64, 4 colunas): guarda frontal, postura de muralha (contra golpes físicos),
#   postura de espelho (contra projéteis), exausto (recuperação após a estocada).

palette fboss
  K = #1b1626
  n = #0c0814
  N = #1e1430
  e = #ffffff
  a = #2b2d48
  b = #465178
  c = #6c7ca8
  d = #a8b8dc
  f = #e8eefc
  v = #3a2450
  V = #57367a
  u = #7a52a0
  U = #a078c8
  w = #cdb2f2
  x = #f0d0ff
  g = #7a5418
  G = #b08428
  y = #e8c050
  Y = #fff0a0
  r = #5a3c26
  R = #85603a
  o = #ff7a3a
end
# segundo gêmeo: ferro enferrujado com placas violeta
palette fboss_b from fboss
  a = #3a2420
  b = #6a3a2c
  c = #a05a3a
  d = #d08a5a
  f = #f0c0a0
  V = #2e3f7c
  u = #4d66ad
  U = #7a9ae0
  w = #b8d0ff
  x = #e8f4ff
end
pal fboss

