# Itens-chave, acessórios de criatura, pedra arremessável e rastro de vento — desenho autoral pixel a pixel.
# icons_chave.png (16x16 x6), icons_criatura.png (16x16 x7), pedra_arremesso.png (16x16), fx_vento.png (16x16 x3).

palette chave from eq
  h = #fff4c0
  a = #c8c0a6
  A = #a8a088
  z = #6a6656
  q = #6f9a4a
  Q = #8fba5a
  e = #c8e8ff
end
pal chave

