# Fortaleza do Eclipse — objetos, mecanismos, ícones e moradores do Refúgio da Muralha. Desenho autoral pixel a pixel.
# fort_props.png (16x16, uma linha; ordem = FortEnt.PROPS em scripts/fort_ent.gd):
#  0 mirror_a  1 mirror_b  2 shutter_open  3 shutter_closed  4 receptor_off  5 receptor_on  6 sun_lens  7 helice0  8 helice1  9 helice2
#  10 crank  11 fresta_off  12 fresta_on  13 solar_cold  14 solar_hot  15 portal_off  16 portal_on  17 fissure_mark  18 balestra
#  19 eclipse_sun  20 eclipse_moon  21 beam_h  22 beam_v  23 beam_spark  24 sym_muralha  25 sym_espelho  26 flecha

