# ================================================================ FERREIRO DEVORADOR 72x72 (chefão)
# Ferreiro gigante corrompido: elmo de ferro com chifres de cobre, barba de escória, fornalha aberta no peito,
# avental de couro e martelo enorme. O quadro 'hurt' usa a mesma pose com a paleta 'mferr_rubro':
# a armadura superaquecida fica rubra/incandescente.
# (linhas compostas à mão segmento a segmento em ferramenta de rascunho; cada pixel abaixo é o desenho final)
palette mferr
  K = #1b1626
  W = #d8d8e8
  M = #a0a0b4
  m = #6e6e84
  l = #4a4a60
  L = #30304a
  g = #5a4a58
  G = #7a6670
  a = #3a2e3a
  A = #6a5450
  z = #8a7068
  t = #6a4a3a
  T = #4a3028
  u = #8a6448
  c = #c0703a
  C = #8a4a24
  x = #e8a060
  h = #8a5a32
  H = #5a3a20
  y = #ffd060
  o = #ff9a40
  r = #e85030
  R = #a02820
  w = #fff4d0
  n = #2a2230
end
palette mferr_rubro from mferr
  W = #fff0b0
  M = #ffb050
  m = #f06a30
  l = #c03a24
  L = #8a2020
  c = #ffd060
  x = #fff4d0
  C = #e85030
  n = #6a1a20
end
pal mferr
