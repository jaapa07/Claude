; Engine configuration file.
config_version=5

[application]

config/name="Ecos da Ruína"
config/description="RPG de ação e captura de criaturas - Capítulo 1: Floresta dos Esquecidos"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/sprites/icon.png"

[autoload]

Data="*res://scripts/data.gd"
Game="*res://scripts/game.gd"
Audio="*res://scripts/audio.gd"
SaveSys="*res://scripts/save_system.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0

[layer_names]

2d_physics/layer_1="paredes"
2d_physics/layer_2="heroi"
2d_physics/layer_3="inimigos"
2d_physics/layer_4="aliados"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.08, 1)
