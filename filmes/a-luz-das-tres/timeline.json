{
 "DUR": 90.0,
 "L": {
  "L1": {
   "at": 1.4,
   "dur": 3.64,
   "end": 5.04,
   "text": "Na Rua da Ladeira, a primeira luz do dia não vinha do sol."
  },
  "L2": {
   "at": 5.9,
   "dur": 2.106,
   "end": 8.006,
   "text": "Vinha da padaria da Dona Zélia."
  },
  "L3": {
   "at": 10.9,
   "dur": 3.656,
   "end": 14.556,
   "text": "Às 3 da manhã, todas as noites, havia 40 anos."
  },
  "L4": {
   "at": 15.4,
   "dur": 2.483,
   "end": 17.883,
   "text": "Ninguém sabia direito quem ela era."
  },
  "L5": {
   "at": 18.4,
   "dur": 3.545,
   "end": 21.945,
   "text": "Mas a rua inteira acertava o relógio pela janela dela."
  },
  "L6": {
   "at": 23.2,
   "dur": 2.19,
   "end": 25.39,
   "text": "A enfermeira, voltando do plantão."
  },
  "L7": {
   "at": 26.6,
   "dur": 1.529,
   "end": 28.129,
   "text": "O menino do jornal."
  },
  "L8": {
   "at": 29.9,
   "dur": 2.296,
   "end": 32.196,
   "text": "O motorista do primeiro ônibus."
  },
  "L9": {
   "at": 37.6,
   "dur": 3.687,
   "end": 41.287,
   "text": "Até que, numa terça-feira, às 3, a janela ficou escura."
  },
  "L10": {
   "at": 43.8,
   "dur": 3.185,
   "end": 46.985,
   "text": "A enfermeira parou. O menino desceu da bicicleta."
  },
  "L11": {
   "at": 49.4,
   "dur": 1.742,
   "end": 51.142,
   "text": "Alguém bateu na porta."
  },
  "L12": {
   "at": 54.0,
   "dur": 2.425,
   "end": 56.425,
   "text": "Dona Zélia tinha caído na cozinha."
  },
  "L13": {
   "at": 57.0,
   "dur": 2.526,
   "end": 59.526,
   "text": "Estava bem. Só não conseguia levantar."
  },
  "L14": {
   "at": 61.0,
   "dur": 3.899,
   "end": 64.899,
   "text": "Naquela madrugada, pela primeira vez, a rua fez o pão por ela."
  },
  "L15": {
   "at": 65.6,
   "dur": 2.151,
   "end": 67.751,
   "text": "Ela ditava a receita da cama."
  },
  "L16": {
   "at": 80.2,
   "dur": 4.236,
   "end": 84.436,
   "text": "Hoje, às 3 da manhã, a Rua da Ladeira tem muitas luzes acesas."
  },
  "L17": {
   "at": 85.2,
   "dur": 2.375,
   "end": 87.575,
   "text": "E ninguém mais acorda sozinho."
  }
 },
