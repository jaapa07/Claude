 "lines": [
  {
   "id": "j1",
   "who": "juninho",
   "at": 4.7,
   "text": "Relaxa, mãe. Um cafezinho resolve tudo."
  },
  {
   "id": "f1",
   "who": "cafe",
   "at": 12.4,
   "text": "EU NÃO AGUENTO MAIS SER BEBIDO POR GENTE BURRA!"
  },
  {
   "id": "j2",
   "who": "juninho",
   "at": 16,
   "text": "Mas eu nem adocei ainda!"
  },
  {
   "id": "f2",
   "who": "cafe",
   "at": 17.75,
   "text": "Fui! Prefiro virar picolé."
  },
  {
   "id": "c1",
   "who": "cleide",
   "at": 20.4,
   "text": "VEM CÁ, MOLEQUE!"
  },
  {
   "id": "r1",
   "who": "controle",
   "at": 23.1,
   "text": "Portal de emergência aberto."
  },
  {
   "id": "j3",
   "who": "juninho",
   "at": 27.2,
   "text": "Errou, mãe."
  },
  {
   "id": "a0",
   "who": "alien",
   "at": 30.55,
   "text": "Povo de Zorg! Hoje conquistaremos o planeta número mil e...",
   "say": "Povo de Zorg! Hoje conquistaremos o planeta número mil e"
  },
  {
   "id": "a1",
   "who": "alien",
   "at": 35.6,
   "text": "QUEM FOI O DESGRAÇADO?!"
  },
  {
   "id": "a2",
   "who": "alien",
   "at": 40.8,
   "text": "Exijo explicações, terráqueos!"
  },
  {
   "id": "j4",
   "who": "juninho",
   "at": 46.2,
   "text": "Calma, chefe. Aceita um pão com mortadela?"
  },
  {
   "id": "a3",
   "who": "alien",
   "at": 54,
   "text": "Passei 800 anos conquistando planetas… e nunca comi um negócio desses.",
   "say": "Passei oitocentos anos conquistando planetas... e nunca comi um negócio desses."
  },
  {
   "id": "c2",
   "who": "cleide",
   "at": 59,
   "text": "Ai, coitadinho..."
  },
  {
   "id": "a4",
   "who": "alien",
   "at": 61,
   "text": "Eu quero TODA a mortadela da Terra!"
  },
  {
   "id": "a5",
   "who": "alien",
   "at": 64.2,
   "text": "Frota de Zorg! Mudança de planos: invadam a Terra e tragam a mortadela!"
  },
  {
   "id": "j5",
   "who": "juninho",
   "at": 69,
   "text": "E o queijo?"
  },
  {
   "id": "a6",
   "who": "alien",
   "at": 70,
   "text": "O queijo pode ficar. Não sou monstro."
  },
  {
   "id": "c3",
   "who": "cleide",
   "at": 80.9,
   "text": "NINGUÉM MEXE NO MEU CAFÉ DA TARDE!"
  }
