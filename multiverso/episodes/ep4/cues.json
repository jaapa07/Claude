 "lines": [
  {
   "id": "i1",
   "who": "imperador",
   "at": 7,
   "text": "VOCÊS HUMILHARAM NOSSA FAMÍLIA!"
  },
  {
   "id": "i2",
   "who": "imperador",
   "at": 9.6,
   "text": "Tinha trinta mil salsichas naquela nave!"
  },
  {
   "id": "j1",
   "who": "juninho",
   "at": 13,
   "text": "Mas eu nem gosto tanto de cachorro-quente!"
  },
  {
   "id": "i3",
   "who": "imperador",
   "at": 19.2,
   "text": "CACHORRO-QUENTE?! ISSO É GENOCÍDIO COM PURÊ!"
  },
  {
   "id": "i4",
   "who": "imperador",
   "at": 23.4,
   "text": "SOLDADOS! GARFOS EM POSIÇÃO!"
  },
  {
   "id": "c1",
   "who": "cleide",
   "at": 33.6,
   "text": "JUNINHO, FAZ ALGUMA COISA, PELO AMOR DE DEUS!"
  },
  {
   "id": "j2",
   "who": "juninho",
   "at": 36.6,
   "text": "Deixa comigo, mãe. Eu tenho um plano."
  },
  {
   "id": "c2",
   "who": "cleide",
   "at": 39,
   "text": "Esse é o problema."
  },
  {
   "id": "r1",
   "who": "controle",
   "at": 42,
   "text": "Modo comida viva. Boa sorte."
  },
  {
   "id": "j3",
   "who": "juninho",
   "at": 46.6,
   "text": "CHAMA OS SALGADOS, POVO!"
  },
  {
   "id": "i5",
   "who": "imperador",
   "at": 53.6,
   "text": "Recuar? Jamais! Mandem a mostarda!"
  },
  {
   "id": "x1",
   "who": "coxinha",
   "at": 61.4,
   "text": "NINGUÉM MEXE COM A CULINÁRIA BRASILEIRA!"
  },
  {
   "id": "i6",
   "who": "imperador",
   "at": 66,
   "text": "Uma... coxinha?"
  },
  {
   "id": "x2",
   "who": "coxinha",
   "at": 68.2,
   "text": "Prova o meu requeijão!"
  },
  {
   "id": "c3",
   "who": "cleide",
   "at": 76.2,
   "text": "Depois eu quero a receita!"
  },
  {
   "id": "r2",
