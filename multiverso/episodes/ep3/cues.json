 "lines": [
  {
   "id": "j1",
   "who": "juninho",
   "at": 6.9,
   "text": "Relaxa, mãe. Deixa que eu negocio."
  },
  {
   "id": "c0",
   "who": "cleide",
   "at": 9.05,
   "text": "Você não negocia nem com o despertador!"
  },
  {
   "id": "j2",
   "who": "juninho",
   "at": 11.45,
   "text": "Calma, campeão! Trouxe um sanduíche da paz!"
  },
  {
   "id": "a1",
   "who": "alien",
   "at": 16.2,
   "text": "Um? UM?! Eu tenho dois mil estômagos!"
  },
  {
   "id": "a2",
   "who": "alien",
   "at": 20.4,
   "text": "POVO DA TERRA! EU EXIJO TODA A MORTADELA DO PLANETA!"
  },
  {
   "id": "j3",
   "who": "juninho",
   "at": 28.6,
   "text": "Pode levar, mas deixa pelo menos o pão francês, seu miserável!"
  },
  {
   "id": "a3",
   "who": "alien",
   "at": 34,
   "text": "Pão francês? Levem também."
  },
  {
   "id": "r1",
   "who": "controle",
   "at": 37.8,
   "text": "Protocolo guerra culinária: ativado."
  },
  {
   "id": "j4",
   "who": "juninho",
   "at": 44.3,
   "text": "QUEIJO, ESCUDO!"
  },
  {
   "id": "r2",
   "who": "controle",
   "at": 50,
   "text": "Botão amarelo: tomate gigante."
  },
  {
   "id": "j5",
   "who": "juninho",
   "at": 57.7,
   "text": "Hm. Faltou sal."
  },
  {
   "id": "c1",
   "who": "cleide",
   "at": 60.6,
   "text": "SAI DA FRENTE QUE A MÃE TÁ PILOTANDO!"
  },
  {
   "id": "j6",
   "who": "juninho",
   "at": 66.3,
   "text": "Mãe, eu vou vomitar!"
  },
  {
   "id": "c2",
   "who": "cleide",
   "at": 67.9,
   "text": "ENGOLE!"
  },
  {
   "id": "r3",
   "who": "controle",
   "at": 76,
   "text": "Aviso: o chinelo era o volante."
  },
  {
   "id": "c3",
   "who": "cleide",
   "at": 78.4,
   "text": "EU SEI!"
  },
  {
   "id": "v1",
   "who": "voz",
   "at": 85.3,
   "text": "Vocês acabaram de declarar guerra ao Império da Salsicha."
  }
 ],
