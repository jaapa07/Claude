   "at": 0.7,
   "text": "Realidade em três por cento. Recomendo pânico."
  },
  {
   "id": "j1",
   "who": "juninho",
   "at": 7.3,
   "text": "Mãe, as estrelas viraram pipoca!"
  },
  {
   "id": "c1",
   "who": "cleide",
   "at": 10.4,
   "text": "PARA DE COMER O UNIVERSO, JUNINHO!"
  },
  {
   "id": "c2",
   "who": "cleide",
   "at": 14.4,
   "text": "O MEU SOFÁ, NÃO!"
  },
  {
   "id": "z1",
   "who": "ze",
   "at": 21.2,
   "text": "Quem foi o animal que ativou o controle universal?"
  },
  {
   "id": "j2",
   "who": "juninho",
   "at": 24.6,
   "text": "Foi sem querer, chefe."
  },
  {
   "id": "z2",
   "who": "ze",
   "at": 27.2,
   "text": "SEM QUERER?! VOCÊ TRANSFORMOU SATURNO NUMA COXINHA!"
  },
  {
   "id": "j3",
   "who": "juninho",
   "at": 31.4,
   "text": "Mas ficou bonita, né?"
  },
  {
   "id": "z3",
   "who": "ze",
   "at": 33.2,
   "text": "Multa de nível universal."
  },
  {
   "id": "j4",
   "who": "juninho",
   "at": 37.2,
   "text": "Aceita Pix?"
  },
  {
   "id": "z4",
   "who": "ze",
   "at": 40,
   "text": "O único jeito de restaurar o universo é apertar o botão de reinicialização."
  },
  {
   "id": "z5",
   "who": "ze",
   "at": 45.15,
   "text": "Mas antes, uma pergunta extremamente simples."
  },
  {
   "id": "z6",
   "who": "ze",
   "at": 48.3,
   "text": "Quanto é dois mais dois?"
  },
  {
   "id": "j5",
   "who": "juninho",
   "at": 60.2,
   "text": "Depende… é com ou sem imposto?"
  },
  {
   "id": "j6",
   "who": "juninho",
   "at": 69,
   "text": "QUATRO! QUATRO, DESGRAÇA!"
  },
  {
