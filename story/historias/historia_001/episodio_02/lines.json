   "pause": 0.38,
   "key": {
    "13": "red"
   },
   "voice": "pm_alex"
  },
  {
   "text": "Do outro lado do vidro, o reflexo se levanta. E encosta a mão no espelho.",
   "pause": 0.38,
   "key": {
    "espelho": "yellow"
   },
   "voice": "pm_alex",
   "speed": 0.94
  },
  {
