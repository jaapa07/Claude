{
  "name": "receita-viral",
  "version": "1.0.0",
  "private": true,
  "description": "Receita Viral — plataforma gastronômica com receitas populares, virais e internacionais.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
