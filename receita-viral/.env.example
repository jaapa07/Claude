# ── Banco de dados (PostgreSQL) ──────────────────────────────
DATABASE_URL="postgresql://receita:receita@localhost:5432/receita_viral?schema=public"

# ── Autenticação ─────────────────────────────────────────────
# Gere com: openssl rand -base64 48   (mínimo 32 caracteres)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres"

# URL pública do app (usada em SEO, sitemap, links de compartilhamento)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Chef IA (opcional) ───────────────────────────────────────
# Sem chave, o Chef IA funciona em "modo local" usando o catálogo do banco.
# A chave fica SOMENTE no servidor — nunca use prefixo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=""
CHEF_AI_MODEL="claude-opus-5-5"

# ── Armazenamento de imagens ─────────────────────────────────
# Diretório local para uploads (servidos por /api/uploads/...)
UPLOAD_DIR="./uploads"
# Tamanho máximo de upload em MB
UPLOAD_MAX_MB="5"

# ── Administrador inicial criado pelo seed ───────────────────
SEED_ADMIN_EMAIL="admin@receitaviral.local"
SEED_ADMIN_PASSWORD="Admin@12345"
